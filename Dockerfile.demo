# Dockerfile.demo - SESTRAV Streamlit Demo
# Installs the core ML stack + streamlit + shap + matplotlib.
FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash sestrav_user
WORKDIR /app
RUN chown -R sestrav_user:sestrav_user /app
USER sestrav_user
ENV PATH="/home/sestrav_user/.local/bin:${PATH}"
ENV PYTHONUNBUFFERED=1
# Agg backend - no display server required
ENV MPLBACKEND=Agg

# Copy minimal source needed for the demo
COPY --chown=sestrav_user:sestrav_user pyproject.toml README.md ./
COPY --chown=sestrav_user:sestrav_user src/ ./src/
COPY --chown=sestrav_user:sestrav_user app/ ./app/
COPY --chown=sestrav_user:sestrav_user config.yaml ./
COPY --chown=sestrav_user:sestrav_user environments/requirements-demo.txt ./environments/requirements-demo.txt
COPY --chown=sestrav_user:sestrav_user environments/requirements-pip-bootstrap.txt ./environments/requirements-pip-bootstrap.txt

# Bootstrap pip from the hash-locked manifest. See that file's header for the
# full rationale, and Dockerfile.api for why the dismissed Scorecard alerts on
# this line (#37 and #38, the demo-image pair) were only half right.
#
# GHSA-qwm4-qh6w-59xr: this image was pinned to pip 26.1.2, inside the affected
# range (first patched 26.2.0).
#
# The dependencies are hash-pinned too. The last command used to be
# `pip install --user ".[demo]"`, which resolved the whole dependency tree from
# PyPI at build time with no hashes (code-scanning alert #84, dismissed on the
# same half-true rationale as the API image's). The image now installs
# environments/requirements-demo.txt: exactly the core requirements and the
# [demo] extra, pinned and seeded as Dockerfile.api describes, then the package
# with --no-deps, and --no-build-isolation so every build uses the setuptools
# installed second, from this lock (`-c`, hash-enforced), instead of an
# unhashed download; Dockerfile.api describes the pattern. Every pin in this
# lock installs from a hashed wheel today; the lock install carries the flag so
# an sdist that enters it later cannot fetch a build backend unhashed.
#
# The package install is still a local-path pip command, which Scorecard still
# reports; a prebuilt wheel is tracked separately.
RUN pip install --user --no-cache-dir --require-hashes --no-deps \
        -r environments/requirements-pip-bootstrap.txt && \
    pip install --user --no-cache-dir --require-hashes --no-deps \
        -c environments/requirements-demo.txt setuptools && \
    pip install --user --no-cache-dir --require-hashes --no-deps --no-build-isolation \
        -r environments/requirements-demo.txt && \
    pip install --user --no-cache-dir --no-deps --no-build-isolation .

EXPOSE 8501

CMD ["streamlit", "run", "app/demo.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--browser.gatherUsageStats=false"]
