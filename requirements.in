fastapi==0.141.1
uvicorn==0.53.0
pydantic==2.13.5

# No keras or protobuf pins. Until this change this file pinned keras==3.15.1
# and protobuf==7.35.1 as "security: minimum version pins" (keras
# GHSA-36fq-jgmw-4r9c and five siblings; protobuf GHSA-m2f8-v8q4-3m59). A line
# here is a requirement, so the pins were what installed them: nothing in the
# closure of this file or environments/requirements-ci.in requires either
# (mhcflurry 2.2.1 is torch-only and declares neither), no tracked module imports
# them, and every keras and protobuf entry in the three locks named next listed
# only a .in spec in its `# via`, never another package. Removing both takes
# keras, protobuf, absl-py, h5py, markdown-it-py, mdurl, ml-dtypes, namex, optree
# and rich out of requirements.txt, environments/requirements-ci.txt and
# environments/requirements.lock, and changes no other pin. If this file's own
# closure ever pulls one of them back in, pin it here again with that dependent
# named.

# Linux-only transitive dependency of xgboost==3.2.0 required for --require-hashes in CI
nvidia-nccl-cu12==2.30.7; platform_system == "Linux"
