# Dockerfile.api - SESTRAV FastAPI Microservice
# Minimal image: installs only the core ML stack + API dependencies.
FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash sestrav_user
WORKDIR /app
RUN chown -R sestrav_user:sestrav_user /app
USER sestrav_user
ENV PATH="/home/sestrav_user/.local/bin:${PATH}"
ENV PYTHONUNBUFFERED=1

# Copy minimal source needed for the API
COPY --chown=sestrav_user:sestrav_user pyproject.toml README.md ./
COPY --chown=sestrav_user:sestrav_user src/ ./src/
COPY --chown=sestrav_user:sestrav_user api/ ./api/
COPY --chown=sestrav_user:sestrav_user config.yaml ./
COPY --chown=sestrav_user:sestrav_user environments/requirements-api.txt ./environments/requirements-api.txt
COPY --chown=sestrav_user:sestrav_user environments/requirements-pip-bootstrap.txt ./environments/requirements-pip-bootstrap.txt

# Bootstrap pip from the hash-locked manifest, for the same two reasons the
# runtime Dockerfile does. See that file's header for the full rationale.
#
# GHSA-qwm4-qh6w-59xr. This image was pinned to pip 26.1.2, inside the affected
# range (first patched 26.2.0). The exposure was NOT visible on the Security
# tab: Scorecard reported it as PinnedDependencies alerts #35 and #36, which
# were dismissed as false positives. The dismissal comment - that a local-path
# install has no remote artifact to hash-pin - was true of the `.[api]` half of
# the RUN line this image then ended with and false of the `pip==` half, which is
# a remote artifact and is hash-pinnable. Scorecard emits one result per unpinned
# pip command but anchors every result to the whole RUN span, so one comment was
# applied to a pair where it held for only one member.
#
# That comment was only partly true of the `.[api]` half as well: `.` itself is
# a local path, but `.[api]` resolved the package's whole dependency tree from
# PyPI at build time with no hashes, torch included (code-scanning alert #83).
# The image now installs environments/requirements-api.txt: exactly the core
# requirements and the [api] extra, each at the version requirements.txt pins
# (jsonschema, which it does not carry, at requirements.lock's), with the
# transitive dependencies they share with requirements.txt at the same versions
# (tests/test_images_install_only_hashed_dependencies.py enforces both), then the
# package with --no-deps so pip cannot re-resolve.
#
# --no-build-isolation stops pip creating a throwaway build environment, which
# downloads [build-system].requires from PyPI, unhashed, for every package it
# builds from source. Every build instead runs against the setuptools installed
# second, taken from this image's own lock: `-c` reads it as a constraints file,
# so pip installs its setuptools pin and enforces that pin's hashes. Every pin
# in this lock installs from a hashed wheel today, so only the package itself
# is built; the lock install carries the flag too, so an sdist that enters the
# lock later cannot fetch a backend unhashed: it builds against that
# setuptools, or fails the build if it needs anything else to build. See
# Dockerfile, whose lock does carry an sdist.
#
# The package install is still a local-path pip command, which Scorecard still
# reports; a prebuilt wheel is tracked separately.
RUN pip install --user --no-cache-dir --require-hashes --no-deps \
        -r environments/requirements-pip-bootstrap.txt && \
    pip install --user --no-cache-dir --require-hashes --no-deps \
        -c environments/requirements-api.txt setuptools && \
    pip install --user --no-cache-dir --require-hashes --no-deps --no-build-isolation \
        -r environments/requirements-api.txt && \
    pip install --user --no-cache-dir --no-deps --no-build-isolation .

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
