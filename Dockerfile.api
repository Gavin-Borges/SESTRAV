# Dockerfile.api - SESTRAV FastAPI Microservice
# Minimal image: installs only the core ML stack + API dependencies.
FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash sestrav_user
WORKDIR /app
RUN chown -R sestrav_user:sestrav_user /app
USER sestrav_user
ENV PATH="/home/sestrav_user/.local/bin:${PATH}"
ENV PYTHONUNBUFFERED=1

# Copy minimal source needed for the API
COPY --chown=sestrav_user:sestrav_user pyproject.toml README.md ./
COPY --chown=sestrav_user:sestrav_user src/ ./src/
COPY --chown=sestrav_user:sestrav_user api/ ./api/
COPY --chown=sestrav_user:sestrav_user config.yaml ./
COPY --chown=sestrav_user:sestrav_user environments/requirements-pip-bootstrap.txt ./environments/requirements-pip-bootstrap.txt

# Bootstrap pip from the hash-locked manifest, for the same two reasons the
# runtime Dockerfile does. See that file's header for the full rationale.
#
# GHSA-qwm4-qh6w-59xr. This image was pinned to pip 26.1.2, inside the affected
# range (first patched 26.2.0). The exposure was NOT visible on the Security
# tab: Scorecard reported it as PinnedDependencies alerts #35 and #36, which
# were dismissed as false positives. The dismissal comment - that a local-path
# install has no remote artifact to hash-pin - is true of the `.[api]` half of
# the line below and false of the `pip==` half, which is a remote artifact and
# is hash-pinnable. Scorecard emits one result per unpinned pip command but
# anchors every result to the whole RUN span, so one comment was applied to a
# pair where it held for only one member.
#
# The second command is still an unpinned local install and Scorecard still
# reports it. Silencing that one needs a prebuilt wheel rather than a bare `.`
# (a `.whl` argument is accepted where `.` is not); it is tracked separately
# and is deliberately NOT bundled into this security fix.
RUN pip install --user --no-cache-dir --require-hashes --no-deps \
        -r environments/requirements-pip-bootstrap.txt && \
    pip install --user --no-cache-dir ".[api]"

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
