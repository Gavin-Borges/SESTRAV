Bootstrap: docker
# Pinned to Python 3.11 to match environments/requirements.lock, which
# tools/update_dependencies.py compiles for 3.11 (--python-version 3.11 in the
# lock's header) and which is installed below with --require-hashes. Keep this
# image in lockstep with that lock: moving it to another Python (e.g. 3.13)
# requires recompiling requirements.lock for that version first, because a lock
# resolved for one Python can carry a package another does not need, or miss one
# it does. The Dockerfile is an exception to this rule, not a precedent for it: it
# installs this same 3.11 lock under 3.13, with --no-deps, so nothing in that build
# resolves the lock for 3.13.
From: python:3.11-slim-bookworm@sha256:8dca233de9f3d9bb410665f00a4da6dd06f331083137e0e98ccf227236fcc438

%labels
    Author SESTRAV Project Contributors
    Version 2.0
    Description SESTRAV - Structural Epitope Scoring via TCR Recognition And Vaccinology

# %files: selective allowlist only. Never use `. /app` here - Apptainer/Singularity
# does NOT honor .dockerignore, so a wildcard copy would bake _local/ (prompts,
# notes, credentials), the .git history, .claude/, .env, and coverage data into
# any distributed .sif. Enumerate only the runtime-required paths.
%files
    pyproject.toml /app/pyproject.toml
    README.md /app/README.md
    config.yaml /app/config.yaml
    pipeline.py /app/pipeline.py
    scripts/fetch_verified_mhcflurry.py /app/scripts/fetch_verified_mhcflurry.py
    src /app/src
    functions /app/functions
    environments /app/environments
    data/proteomes /app/data/proteomes
    models /app/models

%post
    # Stop the build at the first failing command. Apptainer's user guide says a
    # failing command halts the build, but names no shell flag that does it, so
    # %post sets -e itself rather than depend on how Apptainer starts the shell.
    # Each command is on its own line because -e does not apply to a command
    # that fails before the last one of an `a && b` list.
    set -e
    apt-get update
    apt-get install -y --no-install-recommends build-essential
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # The Dockerfile's first three installs, which it explains in full; its fourth,
    # the package itself, has no counterpart here, since this image runs
    # pipeline.py from /app. The lock pins connection-pool as an sdist only, and
    # building it in pip's default isolated environment fetches setuptools from
    # PyPI with no hash. So: the hash-pinned pip bootstrap (hashes from a
    # constraints file need pip 26.1 or later), then setuptools with its version
    # and hashes from the lock used as a constraints file, then the lock built
    # against that setuptools.
    pip install --no-cache-dir --require-hashes --no-deps -r /app/environments/requirements-pip-bootstrap.txt
    pip install --no-cache-dir --require-hashes --no-deps -c /app/environments/requirements.lock setuptools
    pip install --no-cache-dir --require-hashes --no-deps --no-build-isolation -r /app/environments/requirements.lock
    MHCFLURRY_MODEL_URL="$(python -c "import yaml; print(yaml.safe_load(open('/app/config.yaml'))['mhcflurry_model_archive_url'])")"
    MHCFLURRY_MODEL_SHA256="$(python -c "import yaml; print(yaml.safe_load(open('/app/config.yaml'))['mhcflurry_model_archive_sha256'])")"
    MHCFLURRY_ARCHIVE_DIR=/tmp/mhcflurry-models
    mkdir -p "${MHCFLURRY_ARCHIVE_DIR}"
    python /app/scripts/fetch_verified_mhcflurry.py \
        --url "${MHCFLURRY_MODEL_URL}" \
        --sha256 "${MHCFLURRY_MODEL_SHA256}" \
        --output-dir "${MHCFLURRY_ARCHIVE_DIR}"
    mhcflurry-downloads fetch models_class1_presentation \
        --already-downloaded-dir "${MHCFLURRY_ARCHIVE_DIR}"
    rm -f "${MHCFLURRY_ARCHIVE_DIR}/models_class1_presentation.20200611.tar.bz2"
    rmdir "${MHCFLURRY_ARCHIVE_DIR}"

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    cd /app
    python pipeline.py "$@"

%test
    cd /app
    python -c "from src.features import TRAIN_FEATURE_COLUMNS, FEATURE_COLUMNS_31; assert len(TRAIN_FEATURE_COLUMNS) == 21; assert len(FEATURE_COLUMNS_31) == 31; print('Singularity test passed')"
