#!/usr/bin/env bash
# SESTRAV pre-commit hygiene gate
#
# Gate 1 -- blocks staged files whose paths match sensitive categories
# Gate 2 -- scans staged file content for known credential patterns
# Gate 3 -- rejects em-dashes (U+2014) in staged file content
# Gate 4 -- rejects hardcoded workstation absolute paths in staged content
#
# All gates read from the git index (staged content), not the working tree,
# so they cannot be tricked by unstaged modifications to a file.
#
# Emergency override for authorized admin commits only:
#   git commit --no-verify

set -euo pipefail

RED='\033[0;31m'
NC='\033[0m'
block() { printf "${RED}[BLOCKED]${NC} %s\n" "$*" >&2; }

# The filter MUST include R. git does rename detection by default, so a moved
# file is reported as R and an ACM-only filter drops it from this list entirely -
# and every gate below iterates this one list, so a rename bypassed all four.
# Measured on ce31e02: 8 changed paths, 6 of them R100, only 1 survived ACM.
# Renames are not only pure moves either (R056 observed in this history), so
# content can enter through that hole, not merely relocate. With --name-only a
# rename yields its DESTINATION path, which is the one that needs scanning.
# -c core.quotePath=false is load-bearing, not cosmetic. That option defaults to
# TRUE, so any path holding a byte outside ASCII is emitted C-quoted:
# "caf\303\251.txt". Every gate below then asks `git show ":${file}"` for that
# quoted string, git exits 128 because no such path is in the index, and the
# `|| continue` that used to sit on those lines skipped the file in silence.
#
# Measured 2026-09-23 with this hook in a throwaway repo: a staged file named
# with a non-ASCII character and carrying an AWS access key ID committed at
# rc=0, while the identical content in plain.txt was blocked at rc=1. The gate
# was not weak on that file; it never looked at it.
#
# NUL delimiting is the textbook answer and is NOT usable here: the four gates
# consume this value through `while read <<< "$STAGED"`, and bash command
# substitution DISCARDS NUL bytes outright - measured, it prints
# "warning: command substitution: ignored null byte in input" and concatenates
# the entries. Reaching -z means mapfile -d into an array, which needs bash 4.4
# and this hook runs under `#!/usr/bin/env bash`, so a macOS 3.2 bash would
# break outright. Unquoting fixes the case that was measured to leak; the
# remaining quoted shapes now FAIL CLOSED at the git show sites below.
STAGED=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

# ---- Gate 1: Blocked path patterns ------------------------------------------
# Pattern categories (add new entries here, never remove existing ones):
#   - AI assistant configuration files and directories
#   - Session state and personal notes
#   - Prompt artifacts
#   - Credential file extensions (belt-and-suspenders over .gitignore)

BLOCKED_PATTERNS=(
  '^CLAUDE'                  # CLAUDE.md, CLAUDE.local.md
  '^\.claude/'               # Claude Code settings directory
  '^AGENTS'                  # AGENTS.md, AGENTS.local.md (Codex / Cursor / Antigravity)
  '^GEMINI'                  # GEMINI.md, GEMINI.local.md (Gemini / Antigravity)
  '^\.codex/'                # Codex CLI config, hooks, logs
  '^\.agents/'               # Shared skills/rules tree (Codex, Cursor, Antigravity)
  '^\.agent/'                # Same, singular spelling (backward-compat variant)
  '^\.cursor/'               # Cursor AI editor settings
  '^\.cursorrules$'          # Cursor legacy single-file rules
  '^\.gemini/'               # Gemini / Antigravity config
  '^\.antigravity/'          # Antigravity workspace config
  '^\.windsurf/'             # Windsurf AI editor
  '^\.continue/'             # Continue AI plugin
  '^\.cline/'                # Cline plugin
  '^\.aider'                 # Aider tool
  '^\.antigravityrules'      # Antigravity rules file
  # Per-tool context-exclusion files. They hold no secret, but they enumerate this
  # workstation's private paths, which is itself a disclosure.
  '^\.claudeignore$'         # Claude Code context exclusion
  '^\.cursorignore$'         # Cursor context exclusion
  '^\.cursorindexingignore$' # Cursor indexing exclusion
  '^\.antigravityignore$'    # Antigravity (the genuine one; undocumented upstream)
  '^\.aiexclude$'            # Gemini CODE ASSIST, not Antigravity - do not conflate
  '^\.geminiignore$'         # Gemini CLI, also not Antigravity
  '^\.codeiumignore$'        # Codeium / Windsurf (Cognition AI), not Google
  '^\.codexignore$'          # Codex; defensive, not confirmed to exist upstream
  '^\.mcp\.json$'            # MCP server config (infrastructure + token env refs)
  '^STATE\.md$'              # Session state file
  '^_local/'                 # Local workspace (entire subtree)
  '^scratch/'                # Scratch workspace (gitignored; blocks `git add -f`)
  '^dry-runs/'               # Throwaway pipeline runs (NOT gitignored - hook is the only gate)
  '^results/trials/'         # Private/in-progress trial outputs, unlike published results/
  'SESSION_.*\.md$'          # Session note files
  '^NOTES\.md$'              # Personal notes
  '^SCRATCH'                 # Scratch files
  '\.draft\.md$'             # Draft documents
  '\.wip\.md$'               # Work-in-progress files
  '^prompts/'                # Prompts directory
  '\.prompt\.md$'            # Explicit prompt artifact files
  'prompt.*\.md$'            # Files with "prompt" in the name
  '\.key$'                   # Private keys
  '\.pem$'                   # PEM certificates
  '\.p12$'                   # PKCS12 certificates
  '\.pfx$'                   # PFX certificates
  '(^|/)\.env(\.[^/]+)?$'    # .env, .env.local, .env.production, or in any subdir
)

gate1_failed=0
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  for pat in "${BLOCKED_PATTERNS[@]}"; do
    # Here-string, never 'printf ... | grep -q'. See the SIGPIPE note above
    # Gate 2. This gate's producer is a single path and is too short to fill a
    # pipe buffer, so it was not reachable here; it is written the safe way so
    # the file has one form and no reader has to re-derive which sites are safe.
    if grep -qE -- "$pat" <<<"$file" 2>/dev/null; then
      block "Staged file '$file' matches blocked pattern: $pat"
      block "  Correct action: move to _local/ then: git reset HEAD '$file'"
      gate1_failed=1
      break
    fi
  done
done <<< "$STAGED"

if [[ $gate1_failed -ne 0 ]]; then
  printf '\n' >&2
  printf '%s\n' "  Personal artifacts and AI-tooling config must not be committed." >&2
  printf '%s\n' "  See _local/ for the designated workspace for such files." >&2
  exit 1
fi

# ---- Gate 2: Credential content scan ----------------------------------------
# Reads the staged version of each file from the git index (git show :path),
# not the working tree. Checks for known API key and token formats.

CRED_PATTERNS=(
  'sk-ant-api[0-9A-Za-z_-]{20,}'   # Anthropic API key
  'sk-[a-zA-Z0-9]{48}'             # OpenAI API key
  'AIza[0-9A-Za-z_-]{35}'          # Google AI / Firebase key
  # Boundary-anchored: protein FASTA uses the 20-letter amino-acid alphabet, a
  # subset of [A-Z], so a bare 'PREFIX[0-9A-Z]{n}' rule collides with sequence
  # data (the tracked corpus holds ~28.5k distinct 4-letter AA prefixes followed
  # by 16+ uppercase chars). Requiring a non-alphanumeric neighbour on both sides
  # keeps real 20-char key IDs while ignoring keys-shaped runs inside sequences.
  # Pure POSIX ERE - no GNU \b, no lookaround - because this is grep -E.
  # Anchoring is also what makes adding ASIA safe: unanchored it false-positives
  # on DENV2_NGC_panel1.fasta:31 ("...FTDPASIAARGYISTRVEMGEAAGIF...").
  '(^|[^0-9A-Za-z])(AKIA|ASIA)[0-9A-Z]{16}([^0-9A-Za-z]|$)'  # AWS access key ID / temp cred
  'ghp_[a-zA-Z0-9]{36}'            # GitHub personal access token
  'ghs_[a-zA-Z0-9]{36}'            # GitHub Actions token
  'xox[baprs]-[0-9A-Za-z-]{10,}'   # Slack token
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'  # PEM private key block
  'github_pat_[A-Za-z0-9_]{20,}'   # GitHub fine-grained PAT
  'gh[oupsr]_[A-Za-z0-9]{20,}'     # GitHub tokens (oauth/user/pat/server/refresh)
  'sk-(proj|svcacct)-[A-Za-z0-9_-]{20,}'  # OpenAI project/service keys
  'sk-ant-[A-Za-z0-9_-]{20,}'      # Anthropic keys
)

gate2_failed=0
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  # FAIL CLOSED. This was `|| continue`, which treated "I could not read the
  # staged blob" as "this file is clean" - the same conflation
  # scripts/check_secrets.py already fixed for unreadable files, where it
  # reports [UNREADABLE] and returns 1 rather than folding it into a pass.
  if ! staged_content=$(git show ":${file}" 2>/dev/null); then
    block "Could not read staged content for '${file}' - NOT cleared"
    block "  A path git cannot resolve has not been scanned for credentials."
    gate2_failed=1
    continue
  fi
  for pat in "${CRED_PATTERNS[@]}"; do
    # '--' is REQUIRED: the PEM pattern begins with '-----', which grep would
    # otherwise parse as an option bundle, exit 2, and (with stderr suppressed)
    # silently never match - letting private keys through this gate entirely.
    #
    # A HERE-STRING, not 'printf ... | grep -q'. This is the third fail-open
    # found in this file and the mechanism is new: 'grep -q' exits 0 at the
    # FIRST match and closes the pipe, 'printf' is then killed by SIGPIPE and
    # exits 141, and 'set -o pipefail' (line 15) makes the PIPELINE report 141.
    # A non-zero status sends the 'if' down the FALSE branch, so a SUCCESSFUL
    # match was read as "no match" and the gate fell through to exit 0.
    # Measured 2026-09-20 with the real hook: an AWS key id in a 6 KB staged
    # file exits 1 and blocks; the SAME key in a 180 KB file exits 0 and is
    # ACCEPTED. It needs roughly one pipe buffer (~64 KiB) of content after the
    # match point, so it fires on large files and on any commit that also
    # stages one, and the threshold is LOWER on macOS.
    # A here-string is not a pipe: there is no producer to signal, and the
    # status is grep's own. Do NOT "fix" this by removing pipefail.
    if grep -qE -- "$pat" <<<"$staged_content" 2>/dev/null; then
      block "Credential pattern '$pat' detected in staged '$file'"
      block "  Remove the secret, then re-stage: git add '$file'"
      gate2_failed=1
      break
    fi
  done
done <<< "$STAGED"

if [[ $gate2_failed -ne 0 ]]; then
  printf '\n' >&2
  printf '%s\n' "  Secrets must not be committed. Remove the value from the file." >&2
  printf '%s\n' "  If this is a false positive, see scripts/check_secrets.py for the" >&2
  printf '%s\n' "  authoritative scan logic and narrow the exclusion there." >&2
  exit 1
fi

# ---- Gate 3: Em-dash (U+2014) content scan ----------------------------------
# Em-dashes must not appear in committed text. Use ASCII hyphens ('-') instead.
# Rationale: em-dashes caused a CI encoding failure (fa91670) and make diffs,
# logs, and grep output unreliable on non-UTF-8 terminals. Bare hyphen or
# spaced hyphen (' - ') is the project-wide standard.

# One git diff --cached call reads all staged content, then each named file is
# re-read from the index to pinpoint the hit.
#
# The U+2014 pattern is built with printf OCTAL escapes and matched as a literal
# byte string, deliberately NOT with 'grep -qP "\xe2\x80\x94"'. '-P' (PCRE) is a
# GNU extension that BSD grep - /usr/bin/grep on macOS - does not support, and it
# exits 2 there. Both tests below used to discard stderr, so 'if' read that 2 as
# "no match" and the gate passed every em-dash through. That is the same
# fail-open the credential gate above documents for its missing '--' ("exit 2,
# and (with stderr suppressed) silently never match"); it was fixed there and
# not here. printf octal is POSIX-guaranteed, unlike the Bash $'\uXXXX' form
# that .claude/rules/encoding.md rule 4 records as unreliable in this shell, and
# it keeps the banned glyph out of this file.
#
# The '^+' prefilter is split into its own grep so no PCRE is needed. It still
# matches ADDED lines only: an em-dash on a removed ('-') line is ignored,
# verified in both directions.
gate3_failed=0
em_dash=$(printf '\342\200\224')
if [[ -n "$STAGED" ]]; then
  # Staged in two steps rather than as one pipeline, for the SIGPIPE reason
  # documented in Gate 2. This detector was the WORST-placed instance of it:
  # it reads the WHOLE staged diff, so a tiny file carrying an em-dash failed
  # open whenever it was staged alongside one large clean file - a regenerated
  # lockfile is enough. Measured 2026-09-20: a 60-byte doc with two em-dashes
  # exits 1 alone, and exits 0 when staged with a 267 KB clean lockfile.
  # '|| true' is required because grep exits 1 on no match and line 15 sets -e.
  staged_diff=$(git diff --cached 2>/dev/null || true)
  added_lines=$(LC_ALL=C grep '^+' <<<"$staged_diff" || true)
  if LC_ALL=C grep -q -- "$em_dash" <<<"$added_lines"; then
    # Identify which files contain the hit for a useful error message.
    while IFS= read -r file; do
      [[ -z "$file" ]] && continue
      # FAIL CLOSED, as Gate 2 above. An unreadable staged blob is not a clean one.
      if ! staged_content=$(git show ":${file}" 2>/dev/null); then
        block "Could not read staged content for '${file}' - NOT cleared"
        block "  A path git cannot resolve has not been scanned for em-dashes."
        gate3_failed=1
        continue
      fi
      if LC_ALL=C grep -q -- "$em_dash" <<<"$staged_content"; then
        block "Em-dash (U+2014) detected in staged '${file}'"
        block "  Replace the U+2014 character with a plain ASCII '-' or ' - ' (spaced)"
        block "  Quick fix: python -c \"import pathlib; p=pathlib.Path('${file}'); p.write_text(p.read_text(encoding='utf-8').replace('\\u2014','-'), encoding='utf-8')\""
        gate3_failed=1
      fi
    done <<< "$STAGED"
  fi
fi

if [[ $gate3_failed -ne 0 ]]; then
  printf '\n' >&2
  printf '%s\n' "  Em-dashes (U+2014) are banned from this repository." >&2
  printf '%s\n' "  Use ASCII hyphens ('-') or spaced hyphens (' - ') throughout." >&2
  exit 1
fi

# ---- Gate 4: Hardcoded workstation path scan --------------------------------
# Blocks machine-specific absolute paths (a privacy leak: they publish the
# maintainer's username and directory layout). Reads staged content from the
# index, like Gates 2 and 3.
#
# Covers all four workstation path forms (see the patterns below):
#   1. Windows drive-letter profile root, with either separator
#   2. WSL drive mount under /mnt/<drive>
#   3. macOS / bare POSIX profile root
#   4. Linux home root, minus the CI/container accounts allowlisted below
#
# Two deliberate spelling choices keep this file clean under its own gates:
#   - the profile-root directory name is written as "[U]sers", so these patterns
#     never match their own source text and no self-exemption (a blind spot) is
#     needed here;
#   - the comments above avoid spelling out literal example paths, which the
#     CI gate in .github/workflows/pii_scan.yml would flag on sight.
#
# CI, container, and devcontainer accounts are legitimate in Dockerfiles and
# workflows, so /home/<those> is allowed.

WORKSTATION_PATTERNS=(
  '[A-Za-z]:[/\]+[U]sers[/\]+[A-Za-z0-9_.-]+'      # drive-letter, either separator
  '/mnt/[a-z]/[U]sers/[A-Za-z0-9_.-]+'             # WSL mount
  '(^|[^A-Za-z0-9_.-])/[U]sers/[A-Za-z0-9_.-]+'    # macOS / bare POSIX
)
HOME_PATTERN='/home/[A-Za-z0-9_.-]+'
HOME_ALLOWLIST='/home/(sestrav_user|runner|ubuntu|vscode|node|appuser|app)($|[^A-Za-z0-9_.-])'

# Exact repo-relative paths where an example workstation path is legitimately
# quoted. Matched with string equality, never as a substring, so a file merely
# containing one of these names (e.g. "docs/notes_CHANGELOG.md") cannot inherit
# the exemption.
PATH_SCAN_EXEMPT=(
  'CHANGELOG.md'             # documents the historical path-cleanup, quoting an example
)

gate4_failed=0
while IFS= read -r file; do
  [[ -z "$file" ]] && continue

  exempt=0
  for allowed in "${PATH_SCAN_EXEMPT[@]}"; do
    if [[ "$file" == "$allowed" ]]; then
      exempt=1
      break
    fi
  done
  [[ $exempt -eq 1 ]] && continue

  # FAIL CLOSED, as Gates 2 and 3 above.
  if ! staged_content=$(git show ":${file}" 2>/dev/null); then
    block "Could not read staged content for '${file}' - NOT cleared"
    block "  A path git cannot resolve has not been scanned for workstation paths."
    gate4_failed=1
    continue
  fi

  for pat in "${WORKSTATION_PATTERNS[@]}"; do
    if grep -qE -- "$pat" <<<"$staged_content" 2>/dev/null; then
      block "Hardcoded workstation path detected in staged '$file'"
      block "  Matched pattern: $pat"
      gate4_failed=1
      break
    fi
  done

  # Linux home paths: flag any /home/<user> that is not a known CI/container account.
  # Two steps, same SIGPIPE reason as Gate 2. The '-n' guard is REQUIRED and is
  # not cosmetic: a here-string fed an empty variable still presents ONE EMPTY
  # LINE, which does not match the allowlist, so 'grep -qv' would succeed and
  # report a home path on every file that contains none.
  home_hits=$(grep -E -- "$HOME_PATTERN" <<<"$staged_content" 2>/dev/null || true)
  if [[ -n "$home_hits" ]] && grep -qvE -- "$HOME_ALLOWLIST" <<<"$home_hits" 2>/dev/null; then
    block "Hardcoded Linux home path detected in staged '$file'"
    gate4_failed=1
  fi
done <<< "$STAGED"

if [[ $gate4_failed -ne 0 ]]; then
  printf '\n' >&2
  printf '%s\n' "  Machine-specific absolute paths must not be committed: they leak the" >&2
  printf '%s\n' "  maintainer's username and local directory layout, and they break on" >&2
  printf '%s\n' "  other hosts. Use a relative path, pathlib, or a configurable root:" >&2
  printf '%s\n' "    Path(__file__).resolve().parents[1] / 'data'" >&2
  printf '%s\n' "    p.relative_to(repo_root).as_posix()" >&2
  exit 1
fi

exit 0
