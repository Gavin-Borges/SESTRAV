#!/bin/bash
# SESTRAV DCO sign-off automation.
#
# Adds the Developer Certificate of Origin trailer to every commit message
# so that .github/workflows/dco.yml (check_dco) passes on the first push.
#
# Why this exists: sign-offs were previously backfilled onto already-published
# commits with `git rebase --signoff`. That rewrote every SHA in the rebased
# range and silently orphaned the commit hashes cited across tracked docs
# (20 dead citations, repaired 2026-07-24). Signing at commit time removes the
# reason to ever backfill, which removes the rewrite, which removes the
# orphaned-citation defect class at its source.
#
# Never edits history and never blocks a commit: if identity is unset, or git
# interpret-trailers fails, the hook warns and exits 0 so the commit still
# succeeds (CI remains the hard gate).

set -euo pipefail

commit_msg_file="$1"
commit_source="${2-}"

# Merge commits are exempt: dco.yml walks history with --no-merges, and the
# merge message is generated rather than authored.
if [ "$commit_source" = "merge" ]; then
    exit 0
fi

name="$(git config user.name || true)"
email="$(git config user.email || true)"

if [ -z "$name" ] || [ -z "$email" ]; then
    echo "prepare-commit-msg: git user.name/user.email unset - no Signed-off-by added." >&2
    echo "  Set them, or commit with 'git commit -s', or CI will reject the push." >&2
    exit 0
fi

signoff="Signed-off-by: ${name} <${email}>"

# Already signed off by this identity (covers --amend and rebase replays).
if grep -qxF "$signoff" "$commit_msg_file"; then
    exit 0
fi

# Insert the trailer with git's own trailer parser; never append it to the end
# of the file. Under `git commit -v` (or commit.verbose=true) the file ends with
# a scissors line followed by the diff, and git discards everything below the
# scissors line, so an appended trailer was silently dropped and dco.yml then
# failed the pull request. interpret-trailers places it after the last line of
# the real message, above the trailing comment block and the scissors line.
#   --no-divider: a "---" line in a commit body is prose, not a patch divider;
#     without it the trailer lands above that line, mid-message.
#   --where/--if-exists/--if-missing: pinned because a developer's trailer.*
#     config applies here too (trailer.ifmissing=doNothing drops the trailer).
if ! git interpret-trailers --in-place --no-divider \
        --where end --if-exists addIfDifferent --if-missing add \
        --trailer "$signoff" "$commit_msg_file"; then
    echo "prepare-commit-msg: git interpret-trailers failed - no Signed-off-by added." >&2
    echo "  Commit with 'git commit -s', or CI will reject the push." >&2
    exit 0
fi
