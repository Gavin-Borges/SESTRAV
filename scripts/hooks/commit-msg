#!/bin/bash
# SESTRAV authorship, Zero-AI-Footprint, and encoding enforcement.
#
# Rejects commit messages that:
#   1. Reference an AI assistant (Zero AI Footprint policy)
#   2. Carry a Co-authored-by trailer (sole-authorship policy)
#   3. Contain an em-dash (U+2014) - use ASCII hyphens instead

commit_msg_file="$1"

# 1. AI / assistant footprint (Zero AI Footprint policy).
# Narrowed to attribution contexts to allow legitimate tool-config file
# references (.claudeignore, CLAUDE.md, .claude/, claude.ai, Anthropic API).

# 1a. Terms with no legitimate non-attribution use in commit messages:
bare_ai_patterns=("ChatGPT" "Copilot" "Generated with")
for pattern in "${bare_ai_patterns[@]}"; do
    if grep -qi "$pattern" "$commit_msg_file"; then
        echo "Commit rejected: message contains forbidden AI marker '$pattern' (Zero AI Footprint policy)." >&2
        exit 1
    fi
done

# 1b. Contextual attribution patterns for assistant names that may also appear
# legitimately in file paths and config references. This repo is driven by three
# assistants (Claude Code, Codex, Cursor), so the name list must cover all of them -
# a hook that guards only one tool gives the other two a false sense of enforcement.
#   Rejects: "(generated|authored|created|...) with/by <assistant>",
#            "Claude Code", "Signed-off-by: <assistant>", "by Anthropic", "Anthropic AI"
#   Allows:  .claudeignore, CLAUDE.md, .claude/, AGENTS.md, .codex/, .agents/,
#            claude.ai, "Anthropic API", "add anthropic sdk", and any other
#            file-path or config reference to these tools.
# Tradeoff on 'cursor': it is also a common technical noun (DB/text cursor), so it is
# matched ONLY in an explicit attribution context, never bare. If a legitimate message
# like "fix rows created with cursor.executemany" is ever rejected, reword the message -
# do not remove the pattern. The failure is loud and recoverable; a missed AI
# attribution reaching the public history is not.
if grep -qiE \
    "(generated|authored|created|written|made)\s+(with|by)\s+(claude|anthropic|codex|cursor|copilot|chatgpt|gpt)|claude\s+code|signed-off-by\s*:\s*(claude|anthropic|codex|cursor|copilot|chatgpt|gpt)|\bby\s+anthropic\b|anthropic\s+ai\b" \
    "$commit_msg_file"; then
    echo "Commit rejected: message contains AI attribution pattern (Zero AI Footprint policy)." >&2
    exit 1
fi

# 2. Sole authorship: reject ANY co-author trailer (humans included, per policy).
if grep -qi "co-authored-by" "$commit_msg_file"; then
    echo "Commit rejected: 'Co-authored-by' trailer found. Commits must list Gavin Borges as the sole author." >&2
    exit 1
fi

# 3. Em-dash ban: commit messages must use ASCII hyphens, not U+2014.
if LC_ALL=C grep -qP "\xe2\x80\x94" "$commit_msg_file" 2>/dev/null; then
    echo "Commit rejected: em-dash (U+2014) found in commit message." >&2
    echo "  Replace '-' with a plain ASCII '-' or ' - ' (spaced)." >&2
    exit 1
fi

exit 0
