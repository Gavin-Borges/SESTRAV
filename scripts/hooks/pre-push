#!/usr/bin/env bash
# SESTRAV pre-push gate
#
# Check 1 -- blocks direct pushes to the 'main' branch.
#   Every change to main goes through a typed feature branch -> PR -> CI -> merge.
#   Authorized admin/hotfix override: git push --no-verify
#
# Check 2 -- runs the fast test gate before pushing any branch.
#   Heavy/slow tests (GNN checkpoint loads, network calls) are excluded here;
#   they are covered by CI. The gate catches regressions before they reach
#   the remote.
#
# Check 3 -- blocks any institution name that is not on the affiliation
#   allowlist (scripts/check_affiliation_claims.py). Guards claims_register
#   D35, where a fabricated institution reached the public README.

set -uo pipefail

RED='\033[0;31m'
NC='\033[0m'
block() { printf "${RED}[BLOCKED]${NC} %s\n" "$*" >&2; }

# ---- Check 1: Direct-push guard ----------------------------------------
protected_branch="main"

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == "refs/heads/${protected_branch}" ]]; then
        block "Direct push to '${protected_branch}' is not allowed."
        printf '\n' >&2
        printf '%s\n' "  Correct workflow: create a typed feature branch, open a PR," >&2
        printf '%s\n' "  confirm CI is green, then merge via GitHub." >&2
        printf '%s\n' "  Branch naming: feat/ fix/ docs/ chore/ data/ results/" >&2
        printf '%s\n' "                 refactor/ security/ release/" >&2
        printf '\n' >&2
        printf '%s\n' "  Authorized admin override: git push --no-verify" >&2
        exit 1
    fi
done

# ---- Check 2: Fast test gate -------------------------------------------
printf '[pre-push] Running fast test gate (slow GNN tests excluded, covered by CI)...\n'

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Drop the repository-discovery variables git exports into every hook before
# handing off to pytest. They take precedence over cwd, so any test that builds
# a throwaway repo and runs git in it inherits them and operates on THIS repo
# instead. From the main worktree GIT_DIR is relative and re-resolves harmlessly;
# from a linked worktree it is absolute, and on 2026-08-16 that wrote bogus
# "initial" commits onto a real branch ref. Read AFTER REPO_ROOT above, which
# still needs normal discovery. The suite scrubs these itself (conftest.py, and
# per-helper in the affected tests); this closes the pre-push path at its source.
# It does NOT cover other hooks or `git bisect run`, hence the in-suite scrub too.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

# Activate conda environment if not already active.
if [[ -z "${CONDA_DEFAULT_ENV:-}" || "${CONDA_DEFAULT_ENV}" != "sestrav" ]]; then
    if command -v conda >/dev/null 2>&1; then
        eval "$(conda shell.bash hook 2>/dev/null)" && conda activate sestrav 2>/dev/null || true
    fi
fi

# Say WHY when the environment is not usable, instead of blaming the tests.
#
# The activation above is a silent no-op in Git Bash: `command -v conda` finds
# nothing there, because conda is not on PATH under that shell (verified
# 2026-09-02). The gate then runs whatever `python` resolves to - on Windows that
# is usually the WindowsApps store shim, which has no pytest - so `python -m
# pytest` exits non-zero and Check 2 reports "Fast test gate failed. Fix failures
# before pushing."
#
# That message is misleading in the worst way: it names the tests when the tests
# never ran. The gate does FAIL CLOSED, so nothing unsafe reaches the remote, but
# a reader is sent to debug a suite that was never executed. This check converts
# that into an accurate diagnosis. It changes nothing when the environment IS
# active: if pytest imports, the gate proceeds exactly as before.
if ! python -c "import pytest" >/dev/null 2>&1; then
    block "pytest is not importable, so the fast test gate cannot run."
    printf '\n' >&2
    printf '%s\n' "  This is an ENVIRONMENT problem, not a test failure. Nothing ran." >&2
    printf '\n' >&2
    printf '%s\n' "  'conda' is not on PATH in Git Bash, so the activation above is a" >&2
    printf '%s\n' "  no-op and 'python' resolves to an interpreter without pytest." >&2
    printf '\n' >&2
    printf '%s\n' "  Activate the environment, then push again:" >&2
    printf '%s\n' '    eval "$(<conda-root>/Scripts/conda.exe shell.bash hook)"' >&2
    printf '%s\n' "    conda activate sestrav" >&2
    printf '\n' >&2
    printf '%s\n' "  Confirm with:" >&2
    printf '%s\n' "    python -c 'import sys, pytest; print(sys.executable)'" >&2
    exit 1
fi

# Run fast tests: exclude heavy (model checkpoints) and slow (network) markers.
# tests/test_run_analysis_results_guard.py is also excluded here: it imports
# scripts.run_analysis, which imports the `shap` library, which on at least one
# Windows dev machine used on this project crashes the Python process with a
# native Windows exception at import time (scipy.linalg.inv called from
# shap/plots/colors/_colorconv.py) - not catchable by any Python-level marker
# or try/except, since it kills the interpreter before pytest's own marker
# filtering ever runs. Confirmed pre-existing and environment-specific, not
# caused by any change in this repo (python -m src.shap_analysis --help
# crashes identically, unmodified). CI (ubuntu-latest, see ci.yml) is
# unaffected and is the authoritative check for that file; see
# _local/notes/results-dir-silent-overwrite-2026-07-30.md for the full
# writeup. Remove this --ignore if the underlying scipy/shap/MKL conflict is
# ever fixed upstream or the dependency is replaced.
#
# tests/test_pipeline_stages.py is excluded for a second, unrelated reason:
# it imports functions.stage1_peptide_generation, which imports Bio.SeqIO,
# which on at least one Windows dev machine used on this project fails to
# load Bio.Align.substitution_matrices._arraycore with
# "ImportError: DLL load failed while importing _arraycore: An Application
# Control policy has blocked this file." This is an OS-level security policy
# blocking a native extension, not a Python-catchable error, so it kills
# collection before any marker filtering runs - same failure shape as the
# shap case above, different root cause. Confirmed pre-existing and
# environment-specific: `python -c "from Bio import SeqIO"` fails identically
# in total isolation, and the failure reproduces regardless of which branch
# is checked out. CI (ubuntu-latest, see ci.yml) is unaffected and is the
# authoritative check for that file; see
# _local/notes/bio-align-arraycore-application-control-block-2026-08-04.md
# for the full writeup and what remains open (the actual OS policy has not
# been fixed - this only unblocks the local fast gate). Remove this --ignore
# once the Application Control exception is granted or the block is
# otherwise resolved on the affected machine(s).
#
# Four specific parametrized cases in tests/test_entry_point_help_smoke.py
# are deselected for a third, related reason: they invoke
# `python -m src.shap_analysis --help` as a subprocess, which hits the exact
# same native shap/scipy crash described above (confirmed identical
# traceback shape - the interpreter dies before any Python-level assertion
# runs), but this file cannot be --ignore'd wholesale like
# test_run_analysis_results_guard.py, since 73 other passing parametrizations
# in the same file cover every other guarded entry point in this line and
# must keep running. Confirmed independently non-deterministic on the
# affected machine within a single working session: one verification pass
# reproduced 0 of these 4 failures, a later pass reproduced all 4 three times
# in a row - not caused by any specific branch's content (git diff against
# main on src/shap_analysis.py's import section is empty in every case this
# was checked). CI (ubuntu-latest, see ci.yml) is unaffected and is the
# authoritative check for these four cases; see
# _local/notes/results-dir-silent-overwrite-2026-07-30.md for the underlying
# shap/scipy writeup. Remove these --deselect flags once the underlying
# crash is fixed upstream or the dependency is replaced (same condition as
# the test_run_analysis_results_guard.py exclusion above, since both trace to
# the same root cause).
cd "${REPO_ROOT}" && python -m pytest tests/ -q \
    --ignore=tests/test_run_analysis_results_guard.py \
    --ignore=tests/test_pipeline_stages.py \
    --deselect 'tests/test_entry_point_help_smoke.py::test_help_parses_and_exits_clean[src.shap_analysis]' \
    --deselect 'tests/test_entry_point_help_smoke.py::test_output_dir_flag_is_advertised_as_required[src.shap_analysis---output-dir]' \
    --deselect 'tests/test_entry_point_help_smoke.py::test_missing_output_dir_flag_is_rejected[src.shap_analysis---output-dir]' \
    --deselect 'tests/test_entry_point_help_smoke.py::test_allow_overwrite_escape_hatch_is_advertised[src.shap_analysis]'

status=$?

if [[ $status -ne 0 ]]; then
    printf '\n' >&2
    block "Fast test gate failed. Fix failures before pushing."
    exit 1
fi

printf '[pre-push] All fast tests passed.\n'

# ---- Check 3: Affiliation gate -----------------------------------------
# Fails if any tracked file names an institution that is not on the
# allowlist in scripts/check_affiliation_claims.py.
#
# Guards docs/claims_register.md D35. A docs cleanup pass invented an
# institution this project has never had any connection to and it reached
# the public README, where it stood for five weeks. It carried no number, so
# every gate this repo had was blind to it by construction.
#
# Runs after Check 2 to reuse the conda activation above; the check itself
# is stdlib-only and takes under a second.
printf '[pre-push] Checking institution names against the affiliation allowlist...\n'

cd "${REPO_ROOT}" && python scripts/check_affiliation_claims.py

if [[ $? -ne 0 ]]; then
    printf '\n' >&2
    block "Affiliation gate failed. An unreviewed institution name is present."
    printf '\n' >&2
    printf '%s\n' "  This project's affiliation is the University of Rhode Island." >&2
    printf '%s\n' "  If a reported name is claimed as OURS and is not URI, it is a" >&2
    printf '%s\n' "  fabrication - delete it. If it belongs to a cited third party," >&2
    printf '%s\n' "  add it to THIRD_PARTY_INSTITUTIONS in that script with a note" >&2
    printf '%s\n' "  naming what cites it. See docs/claims_register.md D35." >&2
    exit 1
fi

printf '[pre-push] All checks passed -- affiliation allowlist clean.\n'

# ---- Check 4: Integrity harness (local-only; skipped on a bare clone) --
# integrity_check.py resolves REPO_ROOT from __file__ by default, so invoking
# the main checkout's copy from a worktree certifies the WRONG tree. Always
# pass --repo-root as the push source. Never call the harness without that
# flag. A worktree that has not copied _local/integrity/ skips rather than
# falling back to another checkout. This comment once said not to merge
# while main still failed the harness on the pre-registration's
# gitignored-path citation, fixed in 09ee647, an ancestor of ebac4e9.
HARNESS="${REPO_ROOT}/_local/integrity/integrity_check.py"
if [[ -f "${HARNESS}" ]]; then
    printf '[pre-push] Running integrity harness against this worktree...\n'
    python "${HARNESS}" --repo-root "${REPO_ROOT}"
    if [[ $? -ne 0 ]]; then
        printf '\n' >&2
        block "Integrity harness failed for ${REPO_ROOT}."
        printf '\n' >&2
        printf '%s\n' "  The harness must report 0 FAIL / 0 WARN on THIS tree." >&2
        printf '%s\n' "  A green CI run is not integrity evidence." >&2
        exit 1
    fi
else
    printf '[pre-push] No _local/integrity harness in this tree; skipping.\n'
fi

printf '[pre-push] All checks passed -- push allowed.\n'
exit 0
