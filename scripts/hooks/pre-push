#!/usr/bin/env bash
# SESTRAV pre-push gate
#
# Eight numbered checks plus Check 1b, each opened by a banner line that starts
# "# ---- Check", run in the order listed below; any failing check blocks the
# push. Check 1b's banner is indented because it runs inside Check 1's loop over
# the pushed refs. Check 6 runs two scans under one banner, and the second has
# no banner of its own. A shared setup section, also bannered, sits above
# Check 1. To list every banner:
#   grep -n -E '^[[:space:]]*# ---- ' scripts/hooks/pre-push
#
# Shared setup (not a numbered check) -- assigns REPO_ROOT and defines
#   ensure_python, which every check that runs python calls before its first
#   python command. The first call activates the sestrav environment where
#   conda is on PATH and blocks unless `python` imports pytest.
#
# Check 1 -- blocks direct pushes to the 'main' branch.
#   Every change to main goes through a typed feature branch -> PR -> CI -> merge.
#   Authorized admin/hotfix override: git push --no-verify
#
# Check 1b -- pre-flight for a version-tag push, the most irreversible action
#   in this repo and the least protected one. Ruleset 16846770 targets
#   refs/heads/main only, so nothing on the server gates refs/tags/*, and
#   Check 1 above tests refs/heads. A pushed v* tag starts release.yml, which
#   creates a public GitHub Release, and a vX.Y.Z tag also starts docker.yml,
#   which pushes to GHCR. If the PYPI_PUBLISH repository variable is true it
#   also queues an upload that PyPI will never let you replace for that
#   version number.
#   This re-runs release.yml's version assertions LOCALLY, on the files in the
#   commit the tag points at (the commit release.yml checks out), so a mismatch
#   costs a corrected commit instead of a public tag that fails its own
#   release. It is a copy, not the workflow: it can block a few forms
#   release.yml accepts, and it takes pyproject.toml's first 'version = "..."'
#   line instead of parsing TOML.
#
# Check 2 -- runs the fast test gate before pushing any branch.
#   On Windows shells it skips two files and four cases that crash natively
#   there (see the comment above the pytest call); CI runs them. The gate
#   catches regressions before they reach the remote.
#
# Check 3 -- blocks any institution name that is not on the affiliation
#   allowlist (scripts/check_affiliation_claims.py). Guards claims_register
#   D35, where a fabricated institution reached the public README.
#
# Check 4 -- runs the integrity harness. Local-only: _local/ is gitignored, so
#   CI cannot run it and a green CI run is not integrity evidence. Announces a
#   skip when the tree has no harness (the normal case in a worktree).
#
# Check 5 -- re-runs the affiliation gate with --all, covering _local/ drafts
#   and outreach copy. Check 3 and CI both see tracked files only. Outreach
#   publishes where it cannot be edited afterwards, so this is the surface with
#   no second chance. Also local-only, and also announces its skip.
#
# Check 6 -- credential scan, in two passes under one banner:
#   (a) scripts/check_secrets.py's entropy scan over this checkout's files;
#   (b) no banner of its own: an inline Python scan of every scannable blob
#       that the non-merge commits being pushed add or modify, reusing that
#       script's scanner, so content crossing to the remote is scanned even
#       when the checkout no longer holds it. A merge commit's own changes,
#       such as a conflict resolution, are not scanned here: git diff-tree
#       lists no paths for a merge. It prints "Scanning blobs introduced by
#       the pushed commit ranges".
#
# Check 7 -- runs scripts/check_qualifier_bindings.py in its ratchet form: it
#   fails when a binding's violations exceed its violation_ceiling in
#   docs/qualifier_bindings.json. Runs in every clone and never skips.
#
# Check 8 -- runs scripts/check_doc_line_citations.py, the script behind the
#   required context 'Cited lines still hold their content': each pinned line
#   citation must still hold the text recorded for it in
#   docs/line_citations.json, a citation the script scans must have an entry
#   there (it skips the historical ledgers and the other exclusions it
#   lists), and those ledgers together may not hold more line citations than
#   the ceiling that file records. Runs in every clone and never skips.

set -uo pipefail

RED='\033[0;31m'
NC='\033[0m'
block() { printf "${RED}[BLOCKED]${NC} %s\n" "$*" >&2; }

# Read top-level CITATION.cff scalar $1 out of the file text in $2 the way
# release.yml's scalar() does: only spaces or tabs after the colon, an optional
# quote, then everything up to a quote, whitespace or '#'. Reading it any other way
# lets this pre-flight and the Release workflow disagree about one file. The caller
# turns every CR into a line break, as Python's universal newlines do, so CRLF and
# CR-only files yield the lines the workflow sees. The here-string avoids piping
# into `grep -m1`, whose early exit can SIGPIPE a producer and fail the pipeline.
cff_scalar() {
    local line re ws=$' \t'
    line="$(grep -m1 -- "^$1:" <<<"$2")" || return 0
    re="^$1:[${ws}]*[\"']?([^\"'[:space:]#]+)"
    if [[ "$line" =~ $re ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    fi
    return 0
}

# True only for a real calendar date in YYYY-MM-DD form, which is the part of what
# release.yml's datetime.date.fromisoformat accepts that this hook allows. A shape
# check alone would pass 2026-02-30, which the Release workflow rejects.
is_calendar_date() {
    [[ "$1" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})$ ]] || return 1
    local y=$((10#${BASH_REMATCH[1]})) m=$((10#${BASH_REMATCH[2]})) d=$((10#${BASH_REMATCH[3]})) last
    (( y >= 1 && m >= 1 && m <= 12 && d >= 1 )) || return 1
    case "$m" in
        2) if (( (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 )); then last=29; else last=28; fi ;;
        4|6|9|11) last=30 ;;
        *) last=31 ;;
    esac
    (( d <= last ))
}

# ---- Shared setup for every check (not a numbered check) ----------------
# Defined above Check 1 so that no check depends on another check having run
# first. Checks 2 to 8 all need REPO_ROOT, and all of them run bare `python`.
REPO_ROOT="$(git rev-parse --show-toplevel)"

# ensure_python verifies, once per push, the interpreter that bare `python`
# resolves to, and blocks the push with a diagnosis unless it imports pytest.
#
# Bare `python` is whatever PATH resolves. Each check that runs python calls
# ensure_python itself, as a plain statement, before its first python command,
# instead of relying on an earlier check to have verified the interpreter. The
# first call activates the sestrav environment where conda is on PATH, then
# blocks unless `python` imports pytest; every later call returns at once. So
# reordering, removing or skipping checks below this section cannot leave a
# check running an interpreter that nothing verified. A new check that runs
# python must call it too; tests/test_pre_push_interpreter_guard.py fails when
# one does not, or when a check sits above this definition.
#
# Never call it inside $(...) or a pipeline: there it runs in a subshell, and
# its `exit 1` would not stop the hook.
#
# Say WHY when the environment is not usable, instead of blaming the tests.
#
# The activation below is a silent no-op in Git Bash: `command -v conda` finds
# nothing there, because conda is not on PATH under that shell (verified
# 2026-09-02). Without the probe below, the hook would then run whatever
# `python` resolves to - on Windows that is usually the WindowsApps store shim,
# which has no pytest - so `python -m pytest` would exit non-zero and Check 2
# would report "Fast test gate failed. Fix failures before pushing."
#
# That message is misleading in the worst way: it names the tests when the tests
# never ran. The gate does FAIL CLOSED, so nothing unsafe reaches the remote, but
# a reader is sent to debug a suite that was never executed. This preflight
# converts that into an accurate diagnosis. It changes nothing when the
# environment IS active: if pytest imports, the checks proceed exactly as before.
_prepush_python_verified=0
ensure_python() {
    if [[ "${_prepush_python_verified}" -eq 1 ]]; then
        return 0
    fi

    # Activate conda environment if not already active.
    if [[ -z "${CONDA_DEFAULT_ENV:-}" || "${CONDA_DEFAULT_ENV}" != "sestrav" ]]; then
        if command -v conda >/dev/null 2>&1; then
            eval "$(conda shell.bash hook 2>/dev/null)" && conda activate sestrav 2>/dev/null || true
        fi
    fi

    if ! python -c "import pytest" >/dev/null 2>&1; then
        block "pytest is not importable, so no pre-push check that runs python can run."
        printf '\n' >&2
        printf '%s\n' "  This is an ENVIRONMENT problem, not a test failure. Nothing ran." >&2
        printf '\n' >&2
        printf '%s\n' "  'conda' is not on PATH in Git Bash, so the activation above is a" >&2
        printf '%s\n' "  no-op and 'python' resolves to an interpreter without pytest." >&2
        printf '\n' >&2
        printf '%s\n' "  Activate the environment, then push again:" >&2
        printf '%s\n' '    eval "$(<conda-root>/Scripts/conda.exe shell.bash hook)"' >&2
        printf '%s\n' "    conda activate sestrav" >&2
        printf '\n' >&2
        printf '%s\n' "  Confirm with:" >&2
        printf '%s\n' "    python -c 'import sys, pytest; print(sys.executable)'" >&2
        exit 1
    fi

    _prepush_python_verified=1
}

# ---- Check 1: Direct-push guard ----------------------------------------
protected_branch="main"
PUSH_UPDATES="$(mktemp)"
trap 'rm -f "${PUSH_UPDATES}"' EXIT

while read -r local_ref local_sha remote_ref remote_sha; do
    printf '%s\t%s\t%s\t%s\n' \
        "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" >> "${PUSH_UPDATES}"
    if [[ "$remote_ref" == "refs/heads/${protected_branch}" ]]; then
        block "Direct push to '${protected_branch}' is not allowed."
        printf '\n' >&2
        printf '%s\n' "  Correct workflow: create a typed feature branch, open a PR," >&2
        printf '%s\n' "  confirm CI is green, then merge via GitHub." >&2
        printf '%s\n' "  Branch naming: feat/ fix/ docs/ chore/ data/ results/" >&2
        printf '%s\n' "                 refactor/ security/ release/" >&2
        printf '\n' >&2
        printf '%s\n' "  Authorized admin override: git push --no-verify" >&2
        exit 1
    fi
    # ---- Check 1b: release-tag pre-flight ------------------------------
    # A deletion (all-zero local sha) pushes no commit, so there is nothing to read.
    if [[ "$remote_ref" == refs/tags/v* && ! "$local_sha" =~ ^0+$ ]]; then
        tag_name="${remote_ref#refs/tags/}"
        tag_version="${tag_name#v}"
        today="$(date -u +%Y-%m-%d)"
        tag_fail=0

        # Read the carriers from the commit the tag points at, as release.yml's
        # checkout does, never from the working tree, which can hold other content.
        # An annotated tag's sha is peeled to its commit. tr drops a CRLF file's CRs
        # from pyproject.toml and turns every CR in CITATION.cff into a line break.
        py_text=""
        cff_text=""
        if tag_commit="$(git rev-parse --verify --quiet "${local_sha}^{commit}")"; then
            py_text="$(git cat-file blob "${tag_commit}:pyproject.toml" 2>/dev/null | tr -d '\r')"
            cff_text="$(git cat-file blob "${tag_commit}:CITATION.cff" 2>/dev/null | tr '\r' '\n')"
        else
            block "Tag '${tag_name}' does not point at a commit in this repository (${local_sha})."
            tag_fail=1
        fi
        py_version="$(grep -m1 '^version = ' <<<"$py_text" | sed 's/^version = "\(.*\)"/\1/')"
        cff_version="$(cff_scalar version "$cff_text")"
        cff_date="$(cff_scalar date-released "$cff_text")"
        commit_date="$(git show -s --format=%cs "${tag_commit}" 2>/dev/null)"

        if [[ "$py_version" != "$tag_version" ]]; then
            block "pyproject.toml version '${py_version}' does not match tag '${tag_name}'."
            tag_fail=1
        fi
        if [[ "$cff_version" != "$tag_version" ]]; then
            block "CITATION.cff version '${cff_version}' does not match tag '${tag_name}'."
            tag_fail=1
        fi
        if ! is_calendar_date "$cff_date"; then
            block "CITATION.cff date-released '${cff_date}' is not an ISO date."
            tag_fail=1
        elif [[ "$cff_date" > "$today" ]]; then
            block "CITATION.cff date-released '${cff_date}' is in the future (today is ${today})."
            tag_fail=1
        elif ! is_calendar_date "$commit_date"; then
            # Fail closed, as release.yml does when its COMMIT_DATE is not YYYY-MM-DD.
            # For a commit whose committer line holds no parseable date, git show exits
            # 0 and prints the placeholder itself, "%cs" (measured 2026-10-07 on Git for
            # Windows and Linux). '%' sorts before every digit, so the comparison below
            # was false and the lower bound was skipped while the Release workflow
            # rejects the same commit.
            block "The commit '${tag_name}' tags has no readable committer date (git show printed '${commit_date}'), so date-released's lower bound cannot be checked."
            tag_fail=1
        elif [[ "$cff_date" < "$commit_date" ]]; then
            # A release cannot predate the code it ships. Without this bound the only
            # check was "not in the future", so a date left over from an earlier release
            # passed: v2.0.2 and v2.0.3 both shipped date-released 2026-06-12 against
            # commits of 2026-06-16 and 2026-06-17. Compared as ISO strings, as above.
            block "CITATION.cff date-released '${cff_date}' precedes the commit it tags (${commit_date})."
            tag_fail=1
        fi

        if [[ "$tag_fail" -ne 0 ]]; then
            printf '\n' >&2
            printf '%s\n' "  release.yml asserts these only AFTER the tag is public, and the" >&2
            printf '%s\n' "  same push starts docker.yml's container build for a vX.Y.Z tag." >&2
            printf '%s\n' "  Fix the carriers on a branch, merge, then tag the merged commit." >&2
            printf '%s\n' "  Authorized override: git push --no-verify" >&2
            exit 1
        fi

        printf '[pre-push] Release tag %s: version carriers agree, date-released is not future.\n' "$tag_name"
        printf '[pre-push] This push is IRREVERSIBLE: it starts release.yml, and docker.yml for vX.Y.Z.\n'
        printf '[pre-push] If the PYPI_PUBLISH repo variable is true it queues a PyPI upload\n'
        printf '[pre-push] that PyPI will never allow you to replace for this version.\n'
    fi
done

# ---- Check 2: Fast test gate -------------------------------------------
printf '[pre-push] Running fast test gate (Windows shells skip six native-crash targets; CI runs them)...\n'

# Drop the repository-discovery variables git exports into every hook before
# handing off to pytest. They take precedence over cwd, so any test that builds
# a throwaway repo and runs git in it inherits them and operates on THIS repo
# instead. From the main worktree GIT_DIR is relative and re-resolves harmlessly;
# from a linked worktree it is absolute, and on 2026-08-16 that wrote bogus
# "initial" commits onto a real branch ref. Read AFTER REPO_ROOT above, which
# still needs normal discovery. The suite scrubs these itself (conftest.py, and
# per-helper in the affected tests); this closes the pre-push path at its source.
# It does NOT cover other hooks or `git bisect run`, hence the in-suite scrub too.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

ensure_python

# The native-extension exclusions below apply only on Windows shells (Git Bash,
# MSYS2, Cygwin; detected by uname -s). Elsewhere the complete suite runs; all
# 20 formerly excluded tests pass on WSL Ubuntu, and CI's ubuntu-latest test
# job runs them with no exclusions.
# tests/test_run_analysis_results_guard.py is excluded here: it imports
# scripts.run_analysis, which imports the `shap` library, which on at least one
# Windows dev machine used on this project crashes the Python process with a
# native Windows exception at import time (scipy.linalg.inv called from
# shap/plots/colors/_colorconv.py) - not catchable by any Python-level marker
# or try/except, since it kills the interpreter before pytest's own marker
# filtering ever runs. Confirmed pre-existing and environment-specific, not
# caused by any change in this repo (python -m src.shap_analysis --help
# crashes identically, unmodified). CI (ubuntu-latest, see ci.yml) is
# unaffected and is the authoritative check for that file; see
# _local/notes/results-dir-silent-overwrite-2026-07-30.md for the full
# writeup. Remove this --ignore if the underlying scipy/shap/MKL conflict is
# ever fixed upstream or the dependency is replaced.
#
# tests/test_pipeline_stages.py is excluded for a second, unrelated reason:
# it imports functions.stage1_peptide_generation, which imports Bio.SeqIO,
# which on at least one Windows dev machine used on this project fails to
# load Bio.Align.substitution_matrices._arraycore with
# "ImportError: DLL load failed while importing _arraycore: An Application
# Control policy has blocked this file." This is an OS-level security policy
# blocking a native extension, not a Python-catchable error, so it kills
# collection before any marker filtering runs - same failure shape as the
# shap case above, different root cause. Confirmed pre-existing and
# environment-specific: `python -c "from Bio import SeqIO"` fails identically
# in total isolation, and the failure reproduces regardless of which branch
# is checked out. CI (ubuntu-latest, see ci.yml) is unaffected and is the
# authoritative check for that file; see
# _local/notes/bio-align-arraycore-application-control-block-2026-08-04.md
# for the full writeup and what remains open (the actual OS policy has not
# been fixed - this only unblocks the local fast gate). Remove this --ignore
# once the Application Control exception is granted or the block is
# otherwise resolved on the affected machine(s).
#
# Four specific parametrized cases in tests/test_entry_point_help_smoke.py
# are deselected for a third, related reason: they invoke
# `python -m src.shap_analysis --help` as a subprocess, which hits the exact
# same native shap/scipy crash described above (confirmed identical
# traceback shape - the interpreter dies before any Python-level assertion
# runs), but this file cannot be --ignore'd wholesale like
# test_run_analysis_results_guard.py, since 73 other passing parametrizations
# in the same file cover every other guarded entry point in this line and
# must keep running. Confirmed independently non-deterministic on the
# affected machine within a single working session: one verification pass
# reproduced 0 of these 4 failures, a later pass reproduced all 4 three times
# in a row - not caused by any specific branch's content (git diff against
# main on src/shap_analysis.py's import section is empty in every case this
# was checked). CI (ubuntu-latest, see ci.yml) is unaffected and is the
# authoritative check for these four cases; see
# _local/notes/results-dir-silent-overwrite-2026-07-30.md for the underlying
# shap/scipy writeup. Remove these --deselect flags once the underlying
# crash is fixed upstream or the dependency is replaced (same condition as
# the test_run_analysis_results_guard.py exclusion above, since both trace to
# the same root cause).
pytest_platform_args=()
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        pytest_platform_args=(
            --ignore=tests/test_run_analysis_results_guard.py
            --ignore=tests/test_pipeline_stages.py
            --deselect 'tests/test_entry_point_help_smoke.py::test_help_parses_and_exits_clean[src.shap_analysis]'
            --deselect 'tests/test_entry_point_help_smoke.py::test_output_dir_flag_is_advertised_as_required[src.shap_analysis---output-dir]'
            --deselect 'tests/test_entry_point_help_smoke.py::test_missing_output_dir_flag_is_rejected[src.shap_analysis---output-dir]'
            --deselect 'tests/test_entry_point_help_smoke.py::test_allow_overwrite_escape_hatch_is_advertised[src.shap_analysis]'
        )
        ;;
esac

# `${a[@]}` on an EMPTY array aborts under `set -u` (set near the top) on bash <= 4.3,
# which is the stock /bin/bash on macOS (3.2) and reachable through this
# script's `#!/usr/bin/env bash`. README.md addresses macOS developers and
# CONTRIBUTING.md tells every contributor to install these hooks, so the
# non-Windows branch - where this array is empty - is exactly the case that
# would break. The `+` form expands to nothing on every bash version.
cd "${REPO_ROOT}" && python -m pytest tests/ ${pytest_platform_args[@]+"${pytest_platform_args[@]}"}

status=$?

if [[ $status -ne 0 ]]; then
    printf '\n' >&2
    block "Fast test gate failed. Fix failures before pushing."
    exit 1
fi

printf '[pre-push] All fast tests passed.\n'

# ---- Check 3: Affiliation gate -----------------------------------------
# Fails if any tracked file names an institution that is not on the
# allowlist in scripts/check_affiliation_claims.py.
#
# Guards docs/claims_register.md D35. A docs cleanup pass invented an
# institution this project has never had any connection to and it reached
# the public README, where it stood for five weeks. It carried no number, so
# every gate this repo had was blind to it by construction.
#
# Calls ensure_python itself, like every check that runs python. The check
# is stdlib-only and takes about a second.
printf '[pre-push] Checking institution names against the affiliation allowlist...\n'

ensure_python
cd "${REPO_ROOT}" && python scripts/check_affiliation_claims.py

if [[ $? -ne 0 ]]; then
    printf '\n' >&2
    block "Affiliation gate failed. An unreviewed institution name is present."
    printf '\n' >&2
    printf '%s\n' "  This project's affiliation is the University of Rhode Island." >&2
    printf '%s\n' "  If a reported name is claimed as OURS and is not URI, it is a" >&2
    printf '%s\n' "  fabrication - delete it. If it belongs to a cited third party," >&2
    printf '%s\n' "  add it to THIRD_PARTY_INSTITUTIONS in that script with a note" >&2
    printf '%s\n' "  naming what cites it. See docs/claims_register.md D35." >&2
    exit 1
fi

printf '[pre-push] All checks passed -- affiliation allowlist clean.\n'

# ---- Check 4: Integrity harness (local-only; skipped on a bare clone) --
# integrity_check.py resolves REPO_ROOT from __file__ by default, so invoking
# the main checkout's copy from a worktree certifies the WRONG tree. Always
# pass --repo-root as the push source. Never call the harness without that
# flag. A worktree that has not copied _local/integrity/ skips rather than
# falling back to another checkout. This comment once said not to merge
# while main still failed the harness on the pre-registration's
# gitignored-path citation, fixed in 09ee647, an ancestor of ebac4e9.
HARNESS="${REPO_ROOT}/_local/integrity/integrity_check.py"
if [[ -f "${HARNESS}" ]]; then
    printf '[pre-push] Running integrity harness against this worktree...\n'
    ensure_python
    python "${HARNESS}" --repo-root "${REPO_ROOT}"
    if [[ $? -ne 0 ]]; then
        printf '\n' >&2
        block "Integrity harness failed for ${REPO_ROOT}."
        printf '\n' >&2
        printf '%s\n' "  The harness must report 0 FAIL / 0 WARN on THIS tree." >&2
        printf '%s\n' "  A green CI run is not integrity evidence." >&2
        exit 1
    fi
else
    printf '[pre-push] No _local/integrity harness in this tree; skipping.\n'
fi

# ---- Check 5: Affiliation gate, --all (private drafts and outreach copy) --
# Check 3 sees TRACKED files only, which is all CI can EVER see: _local/ is
# gitignored and never cloned, so .github/workflows/affiliation_claims.yml
# cannot carry this no matter how it is written. Measured 2026-09-08 from a
# linked worktree, --all scanned the same 471 files as default mode and exited
# 0 - a silent false all-clear. Local is therefore the only viable carrier.
#
# _local/drafts/ is where manuscript and outreach copy is written, and outreach
# publishes where it cannot be edited afterwards. That is the highest-
# consequence surface in the project and until now no gate ran over it.
#
# Costs about 53s (measured 2026-09-08, 4209 files). Deliberate: the surface it
# covers has no second chance.
if [[ -d "${REPO_ROOT}/_local" ]]; then
    printf '[pre-push] Checking _local/ drafts and outreach copy (--all)...\n'
    ensure_python
    cd "${REPO_ROOT}" && python scripts/check_affiliation_claims.py --all
    if [[ $? -ne 0 ]]; then
        printf '\n' >&2
        block "Affiliation gate (--all) failed in _local/ drafts or outreach copy."
        printf '\n' >&2
        printf '%s\n' "  Outreach publishes where it cannot be edited afterwards." >&2
        printf '%s\n' "  If a reported name is claimed as OURS and is not URI, it is" >&2
        printf '%s\n' "  a fabrication - delete it. Otherwise allowlist that exact" >&2
        printf '%s\n' "  path in scripts/check_affiliation_claims.py with a note" >&2
        printf '%s\n' "  naming what cites it. See docs/claims_register.md D35." >&2
        exit 1
    fi
else
    # Announced, never silent. Check 4 above skips the same way, and a quiet
    # skip reads exactly like a pass - the failure mode this repo keeps hitting.
    printf '[pre-push] SKIPPED --all affiliation scan: no _local/ in %s\n' "${REPO_ROOT}"
    printf '%s\n' "  Worktree or bare clone. Private drafts and outreach copy were"
    printf '%s\n' "  NOT scanned. Before publishing anything, run from the main"
    printf '%s\n' "  checkout: python scripts/check_affiliation_claims.py --all"
fi

# ---- Check 6: Entropy credential scan -----------------------------------
# Fails if any scannable file holds a high-entropy credential-like assignment.
#
# WHY THIS IS HERE AT ALL. scripts/check_secrets.py is this repo's ONLY
# entropy-based credential detector, and until this check it was invoked by
# no hook. Its CI job (`Custom Secret Pattern Scan`, security.yml) runs on
# pull requests but is NOT among ruleset 16846770's required contexts, so it
# reports and does not block. The only credential gate that blocked anything
# was pre-commit Gate 2, a narrower detector: twelve vendor-PREFIX regexes
# (sk-ant-, ghp_, AKIA, a PEM header and so on) and no entropy rule at all.
#
# So a high-entropy value in a format with no known vendor prefix - a
# self-hosted database password, an internal service token - was invisible to
# every blocking gate in this repository and committed and pushed clean.
#
# WHY PRE-PUSH RATHER THAN PRE-COMMIT. This scanner walks the TREE, not the
# staged diff. On pre-commit that means an unrelated pre-existing file could
# block a commit touching something else, and the cost is paid per commit.
# Here the cost is already sunk: Check 2 above runs the full pytest suite, so
# this scan's ~0.6s is noise. The pushed-object scan below covers the content
# crossing the public-remote boundary, including blobs absent from the checkout.
#
# DELIBERATELY UNGUARDED. Checks 4 and 5 skip when _local/ is absent, which
# is the common case in a worktree. scripts/check_secrets.py is TRACKED, so
# it exists in every worktree and every clone, and there is no condition
# under which this check should announce a skip instead of running.
printf '[pre-push] Scanning for high-entropy credential assignments...\n'

ensure_python
cd "${REPO_ROOT}" && python scripts/check_secrets.py

if [[ $? -ne 0 ]]; then
    printf '\n' >&2
    block "Entropy credential scan failed."
    printf '\n' >&2
    printf '%s\n' "  A [FLAGGED] line holds a credential-like assignment whose value" >&2
    printf '%s\n' "  clears both the length and Shannon-entropy floors. The value is" >&2
    printf '%s\n' "  never printed, by design - open the reported file:line yourself." >&2
    printf '%s\n' "  Remove the secret and rotate it; a push is not the first place it" >&2
    printf '%s\n' "  leaked if it is already committed." >&2
    printf '%s\n' "  An [UNREADABLE] line is NOT a false positive either: that file" >&2
    printf '%s\n' "  could not be opened, so nothing about it has been cleared." >&2
    printf '%s\n' "  A genuine false positive requires a documented whole-file or" >&2
    printf '%s\n' "  whole-directory exclusion in scripts/check_secrets.py." >&2
    exit 1
fi

# Check 6, pass (b): the pushed-range blob scan. It has no banner of its own;
# the header lists it under Check 6.
printf '[pre-push] Scanning blobs introduced by the pushed commit ranges...\n'

cd "${REPO_ROOT}" && python - "${PUSH_UPDATES}" <<'PY'
import os
from pathlib import Path, PurePosixPath
import subprocess
import sys
import tempfile

from scripts.check_secrets import EXCLUDE_DIRS, _is_scannable, scan_file

ZERO_SHA = "0" * 40


def git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args], capture_output=True, text=True, encoding="utf-8", errors="replace"
    )


def commits_for(local_sha: str, remote_sha: str) -> list[str]:
    if remote_sha != ZERO_SHA:
        spec = f"{remote_sha}..{local_sha}"
        result = git("rev-list", "--reverse", spec)
    else:
        result = git(
            "rev-list",
            "--reverse",
            local_sha,
            "--not",
            "--remotes=upstream",
            "--remotes=origin",
        )
    if result.returncode != 0:
        print(f"[UNREADABLE-RANGE] cannot enumerate {local_sha}", file=sys.stderr)
        raise SystemExit(1)
    return result.stdout.splitlines()


def changed_paths(commit: str) -> list[str]:
    # -z, as in check_secrets.py's _tracked_paths. Without it git applies
    # core.quotePath, which defaults to true, and a path holding a byte outside
    # ASCII comes back as "caf\303\251.py", quotes included. _is_scannable then
    # rejects that string, so the blob was never scanned and the push passed
    # (measured 2026-10-07 on Git for Windows and Linux;
    # tests/test_pre_push_blob_scan_keeps_non_ascii_names.py pins it). git()
    # above already decodes as UTF-8, the other half of that function's fix.
    result = git(
        "diff-tree",
        "-z",
        "--root",
        "--no-commit-id",
        "--name-only",
        "--diff-filter=AM",
        "-r",
        commit,
    )
    if result.returncode != 0:
        print(f"[UNREADABLE-RANGE] cannot inspect commit {commit}", file=sys.stderr)
        raise SystemExit(1)
    return [path for path in result.stdout.split("\0") if path]


def admitted(path: str) -> bool:
    parts = PurePosixPath(path).parts
    return not any(part in EXCLUDE_DIRS for part in parts) and _is_scannable(path)


flagged = False
updates = Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
with tempfile.TemporaryDirectory(prefix="sestrav-push-scan-") as temp_dir:
    for update in updates:
        _local_ref, local_sha, _remote_ref, remote_sha = update.split("\t")
        if local_sha == ZERO_SHA:
            continue
        for commit in commits_for(local_sha, remote_sha):
            for rel_path in changed_paths(commit):
                if not admitted(rel_path):
                    continue
                blob = subprocess.run(
                    ["git", "show", f"{commit}:{rel_path}"], capture_output=True
                )
                if blob.returncode != 0:
                    print(
                        f"[UNREADABLE-RANGE] {rel_path} at {commit}", file=sys.stderr
                    )
                    flagged = True
                    continue
                temp_path = Path(temp_dir, commit, rel_path)
                temp_path.parent.mkdir(parents=True, exist_ok=True)
                temp_path.write_bytes(blob.stdout)
                lines = scan_file(os.fspath(temp_path))
                if lines:
                    rendered = ",".join(str(line) for line in lines)
                    print(
                        f"[FLAGGED-RANGE] {rel_path} at {commit}: lines {rendered}",
                        file=sys.stderr,
                    )
                    flagged = True

if flagged:
    raise SystemExit(1)
print("[pre-push] Pushed commit ranges contain no credential assignments.")
PY

if [[ $? -ne 0 ]]; then
    printf '\n' >&2
    block "Pushed commit range credential scan failed."
    exit 1
fi

# ---- Check 7: Qualifier bindings ----------------------------------------
# Fails when a bound value gains a violation while its binding sits at its
# ceiling: a new bare occurrence in a scanned file that is not a registered
# carrier, or a QUALIFIED registered carrier that loses its qualifier, is
# deleted, stops being tracked, or whose anchor_pattern stops matching exactly
# one occurrence. Its known limits are recorded in
# .github/workflows/qualifier_bindings.yml. Only TRACKED files are read, so
# gitignored notes in a working checkout cannot block a push.
#
# WHY A SEPARATE CHECK. Check 2 collects tests/test_check_qualifier_bindings.py,
# whose live-tree tests do audit this tree against the ratchet, but a failure
# there surfaces as failing tests inside the suite. This check runs the gate
# itself, so the push is blocked by name with the gate's own report.
#
# RATCHET FORM, NOT --strict. --strict zeroes every ceiling, and it exited 1 on
# the 7 violations present when this check was added (4061aaf1), which would
# have blocked every push. The default form honours the per-binding
# violation_ceiling in docs/qualifier_bindings.json, so it exits 0 today and
# exits 1 the moment the count rises. See the same reasoning, at length, in
# .github/workflows/qualifier_bindings.yml.
#
# THE STANDING DEBT IS PRINTED, NOT SUPPRESSED, on a passing run. Under the
# ceiling this check is silent about nothing: every unrepaired carrier is named
# on every push, so the size of the blind spot stays visible. That is
# scripts/check_digest_portability.py's stated principle for its EXEMPT rows,
# applied to a ratchet.
#
# DELIBERATELY UNGUARDED, for the same reason Check 6 is: the script and its
# config are both TRACKED, so they exist in every worktree and every clone and
# there is no condition under which this should announce a skip.
printf '[pre-push] Checking published values against their qualifier bindings...\n'

ensure_python
cd "${REPO_ROOT}" && python scripts/check_qualifier_bindings.py

if [[ $? -ne 0 ]]; then
    printf '\n' >&2
    block "Qualifier binding gate failed: violations exceed the declared ceiling."
    printf '\n' >&2
    printf '%s\n' "  A published value has lost the qualifier that bounds its meaning," >&2
    printf '%s\n' "  or a tracked file that is not a registered carrier states it bare." >&2
    printf '%s\n' "  The reported file:line is the occurrence; the qualifier must appear" >&2
    printf '%s\n' "  within window_lines of it." >&2
    printf '%s\n' "  Repair the carrier. Do NOT raise a violation_ceiling to clear this:" >&2
    printf '%s\n' "  a ceiling may only be LOWERED, and the declared values are pinned" >&2
    printf '%s\n' "  exactly by tests/test_check_qualifier_bindings.py." >&2
    printf '%s\n' "  After a reviewed repair, run --update in the same commit." >&2
    exit 1
fi

# ---- Check 8: Pinned line citations -------------------------------------
# Fails when scripts/check_doc_line_citations.py reports a problem: a cited
# line that no longer holds the text pinned for it in docs/line_citations.json
# (DRIFTED), a citation with no baseline entry (UNPINNED), more line citations
# in the exempt historical ledgers than the baseline's ceiling (RATCHET), or one
# of the other kinds listed in that script's docstring.
#
# WHY A SEPARATE CHECK. That script, with the argv used here, is what the
# required merge context `Cited lines still hold their content` runs
# (.github/workflows/doc_line_citations.yml). Running it before the push means
# a stale or unpinned citation blocks the push by name, with the gate's own
# report, instead of failing that context afterwards. It runs the gate itself,
# so it does not depend on which tests Check 2 collects.
#
# WHAT IT READS. The gate takes its file list from `git ls-files` and reads
# each file from the working tree, so it audits this checkout as it stands.
# That is the pushed commit only when the checkout is clean and at that commit.
#
# COST. Measured 2026-10-01 on the development workstation: 661 to 698 ms over
# five warm runs, about 1.7 s on a cold first run. Small next to Check 2, which
# runs the test suite.
#
# DELIBERATELY UNGUARDED, for the same reason Checks 6 and 7 are. The script
# and its baseline docs/line_citations.json are both TRACKED and neither is
# gitignored, so both exist in every worktree and every clone. Unlike Checks 4
# and 5, which skip when _local/ is absent, there is no condition under which
# this should announce a skip instead of running.
printf '[pre-push] Checking pinned line citations against their recorded content...\n'

ensure_python
cd "${REPO_ROOT}" && python scripts/check_doc_line_citations.py

if [[ $? -ne 0 ]]; then
    printf '\n' >&2
    block "Pinned line-citation gate failed."
    printf '\n' >&2
    printf '%s\n' "  It runs the same script as the required context 'Cited lines still" >&2
    printf '%s\n' "  hold their content'. Each finding names the CITING file:line," >&2
    printf '%s\n' "  except STALE-PIN and RATCHET, which name the baseline file." >&2
    printf '%s\n' "  DRIFTED means the cited line no longer holds its pinned text, usually" >&2
    printf '%s\n' "  because lines were inserted or removed above it. Repoint the citation," >&2
    printf '%s\n' "  or better, cite the SYMBOL instead - a function or constant name does" >&2
    printf '%s\n' "  not move when lines are inserted above it." >&2
    printf '%s\n' "  UNPINNED means a citation carries no baseline entry yet." >&2
    printf '%s\n' "  Run 'python scripts/check_doc_line_citations.py --update', then READ" >&2
    printf '%s\n' "  THE DIFF: a changed pin is either a deliberate repoint or the rot" >&2
    printf '%s\n' "  itself, and the script cannot tell you which." >&2
    printf '%s\n' "  RATCHET means the historical ledgers (EXEMPT_CITING_FILES in that" >&2
    printf '%s\n' "  script) together hold more line citations than the recorded ceiling." >&2
    printf '%s\n' "  Cite the SYMBOL or write the reference as prose. --update would clear" >&2
    printf '%s\n' "  it only by RAISING the ceiling, which needs a stated reason." >&2
    exit 1
fi

printf '[pre-push] All checks passed -- push allowed.\n'
exit 0
